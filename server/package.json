{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx ../node_modules/jasmine/bin/jasmine",
    "start-jobs:dev": "tsx watch --inspect=9230 jobs/index.ts",
    "start-jobs:prod": "node dist/jobs/index.js",
    "start-api:dev": "tsx watch --inspect=9231 api/index.ts",
    "start-api:prod": "node dist/api/index.js",
    "start-db-migrate:dev": "tsx --inspect=9235 tools/migrate.ts",
    "start-db-migrate:prod": "node dist/tools/migrate.js",
    "start-db-recalc-ranks:dev": "tsx watch --inspect=9234 tools/recalculateRankings.ts",
    "start-db-recalc-ranks:prod": "node dist/tools/recalculateRankings.js",
    "start-db-recalc-stats:dev": "tsx watch --inspect=9234 tools/recalculateStats.ts",
    "start-db-recalc-stats:prod": "node dist/tools/recalculateStats.js",
    "start-db-sync-indices:dev": "tsx watch --inspect=9234 tools/syncIndices.ts",
    "start-db-sync-indices:prod": "node dist/tools/syncIndices.js",
    "restore-game": "tsx tools/restoreGame.ts",
    "research-progress-samples": "tsx tools/researchProgressSamples.ts",
    "prebuild": "rm -rf ./dist",
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "author": "",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "axios": "1.16.1",
    "bcrypt": "6.0.0",
    "compression": "1.8.1",
    "connect-mongo": "6.0.0",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "discord.js": "14.26.4",
    "dotenv": "17.4.2",
    "elo-rating": "1.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "8.5.2",
    "express-session": "1.19.0",
    "memory-cache": "0.2.0",
    "luxon": "3.5.0",
    "mongoose": "9.6.2",
    "mongoose-lean-defaults": "2.3.1",
    "nodemailer": "8.0.9",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "qheap": "1.4.0",
    "random-seed": "0.3.0",
    "simplex-noise": "4.0.3",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.18.2",
    "@types/jasmine": "5.1.5",
    "@types/nodemailer": "8.0.0",
    "@types/compression": "1.8.1",
    "@types/luxon": "3.4.2",
    "@types/node": "24",
    "jasmine": "5.13.0",
    "tsx": "4.22.4"
  }
}
