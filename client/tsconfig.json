{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": false,
        "noUncheckedIndexedAccess": false,
        "paths": {
            "@solaris/common": ["../common/src/index.ts"],
            "@solaris/map-rendering": ["../map-rendering/src/index.ts"],
            "@solaris/map-rendering/*": ["../map-rendering/src/*"],
            "@solaris/api-client": ["../api-client/src/index.ts"],
            "@solaris/api-client/*": ["../api-client/src/*"],
            "@/*": ["./src/*"]
        },
        "lib": ["es2024", "DOM", "DOM.Iterable"]
    },
    "extends": "@vue/tsconfig/tsconfig.dom.json"
}
